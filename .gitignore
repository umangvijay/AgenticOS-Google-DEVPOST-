# Environments
.env
.env.local
.env.*.local

# Local runtime data (do not publish inboxes, SQLite, or generated Studio apps)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.json
data/artifacts/
frontend/data/contact_inbox.json

# Cloud / Google credential files only (not the Vault UI)
**/serviceAccount*.json
**/google-credentials.json
**/application_default_credentials.json

# Python
__pycache__/
.pytest_cache/
.venv/
*.pyc
*.pyo

# Node
node_modules/
.next/

# Security keys
backend/security/keys/*.pem

# Local logs
*.log

# macOS
.DS_Store

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
