APP_ENV=development
APP_NAME=AgentOS
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Local laptop: sqlite (default). Cloud Run: set STORAGE_BACKEND=firestore.
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/agentos.db

# Cloud Run production: STORAGE_BACKEND=firestore, GOOGLE_CLOUD_PROJECT=agentos-devpost
# Leave GEMINI_API_KEY empty on Cloud Run (Vertex + ADC). Do not invent model IDs.
# CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.run.app
# SECRETS_MASTER_KEY, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY come from Secret Manager.

# Required on Cloud Run with Firestore. Leave empty locally.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
FIRESTORE_DATABASE_ID=(default)

FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_WORKFLOWS=workflows
FIRESTORE_COLLECTION_RUNS=runs
FIRESTORE_COLLECTION_TASKS=tasks

GEMINI_MODEL=gemini-3.6-flash
# Local: paste an AI Studio key. Cloud: leave blank and set GOOGLE_CLOUD_PROJECT
# so AgentOS uses Vertex AI (higher RPM/TPM, billed to the GCP project).
GEMINI_API_KEY=

# Optional Grok fallback when Gemini quota is exhausted
XAI_API_KEY=
GROK_MODEL=grok-4-fast

# Contact form — Gmail App Password only, never the mailbox password.
# https://myaccount.google.com/apppasswords
CONTACT_TO_EMAIL=godumang35@gmail.com
CONTACT_FROM_EMAIL=godumang35@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=godumang35@gmail.com
CONTACT_SMTP_PASSWORD=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=

# Optional HMAC pepper mixed into account passwords before bcrypt (new hashes only).
PASSWORD_PEPPER=
