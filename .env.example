APP_ENV=development
APP_NAME=AgentOS
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_REGION=us-central1
FIRESTORE_DATABASE_ID=(default)

FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_WORKFLOWS=workflows
FIRESTORE_COLLECTION_RUNS=runs
FIRESTORE_COLLECTION_TASKS=tasks

GEMINI_MODEL=gemini-3.5-flash
# Leave GEMINI_API_KEY blank to use Application Default Credentials (Vertex AI)
GEMINI_API_KEY=

# Optional Grok fallback when Gemini quota is exhausted
XAI_API_KEY=
GROK_MODEL=grok-4-fast

# Contact form — SMTP is required for mail to actually arrive.
# Gmail: https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# Create a 16-character App Password and paste it below. Never commit the real value.
CONTACT_TO_EMAIL=godumang35@gmail.com
CONTACT_FROM_EMAIL=godumang35@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=godumang35@gmail.com
CONTACT_SMTP_PASSWORD=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=

# Optional HMAC pepper mixed into account passwords before bcrypt (new hashes only).
PASSWORD_PEPPER=
